@page "/projetos/{Id:int}"
@inject PortfolioService Portfolio
@inject ILogger<ProjectDetail> Logger

@if (_project is not null)
{
    <PageTitle>@_project.Title | Projetos</PageTitle>
    <HeadContent>
        <meta name="description" content="@_project.Summary" />
        <meta property="og:title" content="@_project.Title" />
        @if (!string.IsNullOrWhiteSpace(_project.DisplayCoverUrl))
        {
            <meta property="og:image" content="@_project.DisplayCoverUrl" />
        }
    </HeadContent>

    <article class="section container page-top project-detail">
        <a href="/projetos" class="link-back"><Icon Name="arrow-left" Size="16" /> Voltar aos projetos</a>

        <header class="detail-head">
            <h1 class="display-sm">@_project.Title</h1>
            <p class="lead">@_project.Summary</p>
            <div class="detail-actions">
                @if (!string.IsNullOrWhiteSpace(_project.LiveUrl))
                {
                    <a href="@_project.LiveUrl" target="_blank" rel="noopener" class="btn btn-primary"><Icon Name="external" /> Ver online</a>
                }
                @if (_project.ShowRepository && !string.IsNullOrWhiteSpace(_project.RepositoryUrl))
                {
                    <a href="@_project.RepositoryUrl" target="_blank" rel="noopener" class="btn btn-ghost"><Icon Name="github" /> Código fonte</a>
                }
            </div>
        </header>

        <!-- PASSADOR DE MÍDIAS (HERO CAROUSEL) -->
        <div class="detail-cover glass">
            @if (_slides.Count > 0)
            {
                var currentSlide = _slides[_currentSlideIndex];
                <div class="carousel-viewport">
                    <div class="carousel-slide" @key="currentSlide.Url">
                        @if (currentSlide.Type == MediaType.Video)
                        {
                            <div class="carousel-video-wrapper">
                                <video src="@currentSlide.Url" controls preload="metadata" playsinline></video>
                            </div>
                        }
                        else
                        {
                            <img src="@currentSlide.Url" alt="@_project.Title" @onclick="() => _activeImageModal = currentSlide.Url" title="Clique para ampliar" />
                        }
                    </div>
                </div>

                @if (_slides.Count > 1)
                {
                    <button type="button" class="carousel-nav-btn prev" aria-label="Mídia anterior" @onclick="PrevSlide">
                        <Icon Name="chevron-left" Size="24" />
                    </button>
                    <button type="button" class="carousel-nav-btn next" aria-label="Próxima mídia" @onclick="NextSlide">
                        <Icon Name="chevron-right" Size="24" />
                    </button>

                    <div class="carousel-counter">
                        @(_currentSlideIndex + 1) / @_slides.Count
                    </div>

                    <div class="carousel-dots">
                        @for (var i = 0; i < _slides.Count; i++)
                        {
                            var idx = i;
                            <button type="button" 
                                    class="carousel-dot @(idx == _currentSlideIndex ? "active" : "")" 
                                    aria-label="Ir para mídia @(idx + 1)"
                                    @onclick="() => GoToSlide(idx)">
                            </button>
                        }
                    </div>
                }
            }
            else
            {
                <div class="thumb-fallback big"><span>@_project.Title[..1]</span></div>
            }
        </div>

        <div class="detail-grid">
            <div class="detail-body">
                <h2>Sobre o projeto</h2>
                @if (string.IsNullOrWhiteSpace(_project.Description))
                {
                    <p class="muted">@_project.Summary</p>
                }
                else
                {
                    @foreach (var paragraph in _project.Description.Split("\n\n", StringSplitOptions.RemoveEmptyEntries))
                    {
                        <p class="pre-line">@paragraph.Trim()</p>
                    }
                }
            </div>

            <aside class="card glass detail-side">
                <h3>Tecnologias</h3>
                <ul class="tags">
                    @foreach (var t in _project.TechList)
                    {
                        <li class="tag">@t</li>
                    }
                </ul>
                <h3>Publicado em</h3>
                <p class="muted"><Icon Name="calendar" Size="16" /> @_project.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</p>
            </aside>
        </div>
    </article>

    @* MODAL LIGHTBOX PARA AMPLIAR IMAGEM *@
    @if (!string.IsNullOrWhiteSpace(_activeImageModal))
    {
        <div class="lightbox-backdrop" @onclick="() => _activeImageModal = null">
            <div class="lightbox-content" @onclick:stopPropagation="true">
                <button type="button" class="lightbox-close" aria-label="Fechar" @onclick="() => _activeImageModal = null">
                    <Icon Name="x" Size="24" />
                </button>
                <img src="@_activeImageModal" alt="Visualização ampliada" />
            </div>
        </div>
    }
}
else if (_notFound)
{
    <PageTitle>Projeto não encontrado</PageTitle>
    <section class="container empty-page">
        <span class="eyebrow">404</span>
        <h1 class="display-sm">Projeto não encontrado</h1>
        <p class="muted">Ele pode ter sido removido ou ainda não foi publicado.</p>
        <a href="/projetos" class="btn btn-primary">Ver todos os projetos</a>
    </section>
}
else
{
    <section class="container page-top"><div class="card skeleton tall"></div></section>
}

@code {
    [Parameter] public int Id { get; set; }

    private Project? _project;
    private bool _notFound;
    private string? _activeImageModal;

    private record SlideItem(string Url, MediaType Type);
    private readonly List<SlideItem> _slides = [];
    private int _currentSlideIndex = 0;

    protected override async Task OnParametersSetAsync()
    {
        _project = null;
        _notFound = false;
        try
        {
            _project = await Portfolio.GetProjectAsync(Id, publishedOnly: true);
            SetupSlides();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao carregar projeto {Id}", Id);
        }
        _notFound = _project is null;
    }

    private void SetupSlides()
    {
        _slides.Clear();
        _currentSlideIndex = 0;
        if (_project is null) return;

        // Se houver capa principal, inicia com ela
        if (!string.IsNullOrWhiteSpace(_project.ImageUrl))
        {
            _slides.Add(new SlideItem(_project.ImageUrl, MediaType.Image));
        }

        // Adiciona as mídias da galeria, evitando duplicar caso a URL seja igual à capa
        foreach (var m in _project.Medias)
        {
            if (!_slides.Any(s => s.Url.Equals(m.MediaUrl, StringComparison.OrdinalIgnoreCase)))
            {
                _slides.Add(new SlideItem(m.MediaUrl, m.MediaType));
            }
        }
    }

    private void NextSlide()
    {
        if (_slides.Count <= 1) return;
        _currentSlideIndex = (_currentSlideIndex + 1) % _slides.Count;
    }

    private void PrevSlide()
    {
        if (_slides.Count <= 1) return;
        _currentSlideIndex = (_currentSlideIndex - 1 + _slides.Count) % _slides.Count;
    }

    private void GoToSlide(int index)
    {
        if (index >= 0 && index < _slides.Count)
        {
            _currentSlideIndex = index;
        }
    }
}
